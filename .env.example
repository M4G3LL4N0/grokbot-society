# GrokBot Society Configuration
# Copy this file to .env and adjust values as needed

# Database
# SOCIETY_DB=./society.db

# User identity (used as actor in scenes)
# SOCIETY_USER=You

# User social intensity: quiet | low | normal | social | very_social | do_not_disturb
# SOCIETY_INTENSITY=normal

# Provider API keys (optional - only needed for paid inference tiers)
# SOCIETY_NANO_API_KEY=your_nano_key_here
# OPENAI_API_KEY=your_openai_key_here
# GROK_API_KEY=your_grok_key_here

# Logging
# DEBUG=grokbot:*